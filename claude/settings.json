{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_EXPORTER_OTLP_LOGS_ENDPOINT": "http://localhost:19222/v1/logs",
    "OTEL_EXPORTER_OTLP_LOGS_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_METRICS_ENDPOINT": "http://localhost:19222/v1/metrics",
    "OTEL_EXPORTER_OTLP_METRICS_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://localhost:19222/v1/traces",
    "OTEL_EXPORTER_OTLP_TRACES_PROTOCOL": "http/protobuf",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp"
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(xargs:*)",
      "Bash(lsof:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(cd:*)",
      "mcp__atlassian__confluence_get_page",
      "mcp__atlassian__confluence_get_page_children",
      "mcp__atlassian__confluence_get_page_history",
      "mcp__atlassian__confluence_get_page_diff",
      "mcp__atlassian__confluence_get_page_views",
      "mcp__atlassian__confluence_get_page_images",
      "mcp__atlassian__confluence_get_comments",
      "mcp__atlassian__confluence_get_labels",
      "mcp__atlassian__confluence_get_attachments",
      "mcp__atlassian__confluence_search",
      "mcp__atlassian__confluence_search_user",
      "mcp__atlassian__confluence_download_attachment",
      "mcp__atlassian__confluence_download_content_attachments",
      "mcp__atlassian__jira_get_issue",
      "mcp__atlassian__jira_get_issue_dates",
      "mcp__atlassian__jira_get_issue_images",
      "mcp__atlassian__jira_get_issue_sla",
      "mcp__atlassian__jira_get_issue_watchers",
      "mcp__atlassian__jira_get_issue_development_info",
      "mcp__atlassian__jira_get_issues_development_info",
      "mcp__atlassian__jira_get_issue_proforma_forms",
      "mcp__atlassian__jira_get_proforma_form_details",
      "mcp__atlassian__jira_get_transitions",
      "mcp__atlassian__jira_get_worklog",
      "mcp__atlassian__jira_get_link_types",
      "mcp__atlassian__jira_get_user_profile",
      "mcp__atlassian__jira_get_all_projects",
      "mcp__atlassian__jira_get_project_components",
      "mcp__atlassian__jira_get_project_issues",
      "mcp__atlassian__jira_get_project_versions",
      "mcp__atlassian__jira_get_field_options",
      "mcp__atlassian__jira_get_agile_boards",
      "mcp__atlassian__jira_get_board_issues",
      "mcp__atlassian__jira_get_sprints_from_board",
      "mcp__atlassian__jira_get_sprint_issues",
      "mcp__atlassian__jira_get_service_desk_for_project",
      "mcp__atlassian__jira_get_service_desk_queues",
      "mcp__atlassian__jira_get_queue_issues",
      "mcp__atlassian__jira_batch_get_changelogs",
      "mcp__atlassian__jira_search",
      "mcp__atlassian__jira_search_fields",
      "mcp__atlassian__jira_download_attachments",
      "mcp__datadog__analyze_datadog_logs",
      "mcp__datadog__get_datadog_error_tracking_issue",
      "mcp__datadog__get_datadog_incident",
      "mcp__datadog__get_datadog_metric",
      "mcp__datadog__get_datadog_trace",
      "mcp__datadog__search_datadog_error_tracking_issues",
      "mcp__datadog__search_datadog_incidents",
      "mcp__datadog__search_datadog_logs",
      "mcp__datadog__search_datadog_metrics",
      "mcp__datadog__search_datadog_monitors",
      "mcp__datadog__search_datadog_spans"
    ],
    "deny": [],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bits/bark-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bits/permission-hook.sh",
            "timeout": 120,
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bits/bark-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/bits/wake-hook.sh",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "todoist@doist": true,
    "trajectory@trajectory": true,
    "trajectory-security@trajectory": true
  },
  "extraKnownMarketplaces": {
    "doist": {
      "source": {
        "source": "github",
        "repo": "doist/todoist-mcp"
      }
    },
    "trajectory": {
      "source": {
        "source": "directory",
        "path": "~/.trajectory/claude-marketplace"
      }
    },
    "datadog-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "ddoghq/claude-marketplace"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true
}
