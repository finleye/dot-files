{
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:context-mode",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-markdown-preview",
    "npm:pi-powerline-footer",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@datadog/pi-plugin",
    "../../dd/datadog-pi-packages/packages/refresh-models",
    "../../dd/datadog-pi-packages/packages/research-web",
    "../../dd/datadog-pi-packages/packages/confluence-adf",
    "../../dd/datadog-pi-packages/packages/loop",
    "../../dd/datadog-pi-packages/packages/notifications",
    "../../dd/datadog-pi-packages/packages/compaction-continue",
    "../../dd/datadog-pi-packages/packages/session-cost",
    "npm:@getpipher/vision"
  ],
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "skills": [
    "~/.claude/skills",
    "~/.codex/skills"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "powerline": {
    "customItems": [
      {
        "id": "session-cost",
        "statusKey": "session-cost",
        "position": "secondary",
        "excludeFromExtensionStatuses": true
      }
    ]
  },
  "hideThinkingBlock": false,
  "extensions": [
    "-builtin:mcp"
  ]
}