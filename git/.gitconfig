[user]
	name = Corey Finley
	email = corey.finley@datadoghq.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDNCFFi+EtVXTYIxgwr5PTEDCeQ97iuXUqX6KfXhAQ78 corey.finley+git-commit-signing@datadoghq.com
[core]
  editor = vim
	excludesfile = /Users/corey/.gitignore_global
	hooksPath = /usr/local/dd/global_hooks
[alias]
  b = branch
  l = log --graph --pretty=format:'%Cred%h%Creset %an: %s - %Creset %C(yellow)%d%Creset %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  rh = reset --hard
  co = checkout
  cb = checkout -b
  st = status
  ci = commit
  ca = commit --amend
  ri = rebase -i
  bd = branch -D
  ft = fetch
  pl = pull
  pf = push -f
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  cbt = checkout -b -t
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[push]
  default = current
[pull]
  default = current
  rebase = true
[rerere]
  enabled = true
[branch]
  autosetuprebase = always
[commit]
	gpgsign = true
[gpg]
	format = ssh
[url "git@github.com:"]
	insteadOf = https://github.com/
	insteadOf = git://github.com/
[safe]
